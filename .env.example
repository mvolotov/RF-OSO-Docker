# RF Online: Golden Age (rf2232) - Docker configuration.
# Copy to .env and edit. Every RF_* setting below is applied to settings.cfg by
# the init container on each start, so .env is the single source of truth.
# Values are plain KEY=value (no spaces around '=').

# ---------------------------------------------------------------- build ----
# The unpacked server bundle the images are built from (relative to this folder).
RF_BUNDLE_DIR=../rf2232-v0.6.0
RF_IMAGE_PREFIX=rf2232
RF_IMAGE_TAG=0.7.0
# Compose project name (container prefix).
RF_PROJECT=rf2232

# --------------------------------------------------------------- runtime ---
# Host folder with all mutable state: settings/, db/, logs/, backups/, webassets/, client/, custom/
RF_DATA_DIR=./data
# Host user that owns RF_DATA_DIR; the servers run as this uid/gid (see: id -u / id -g).
RF_UID=1000
RF_GID=1000
# Time zone for logs and backup names.
TZ=UTC

# --------------------------------------------------------------- network ---
# Address players connect to; written into client/launcher.ini (Host =) that the
# website hands out. 127.0.0.1 only works on this machine.
RF_PUBLIC_HOST=127.0.0.1
# Host interface the ports are published on (0.0.0.0 = all).
RF_BIND_ADDR=0.0.0.0
# Game client socket (settings.cfg SERVICE_PORT). The launcher port is always
# SERVICE_PORT + 1 (27801); rfctl publishes it and writes both into launcher.ini.
# If you run raw "docker compose", also set RF_LAUNCHER_PORT when you change this.
RF_SERVICE_PORT=27800
# Website/control panel host port (plain HTTP mode).
RF_WEB_PORT=8080
# Optional: written into launcher.ini [Update] URL so the launcher fetches client
# patches from your website, e.g. http://203.0.113.10:8080 or https://rf.example.com
RF_LAUNCHER_UPDATE_URL=
# Folder with launcher.ini + rflauncher.exe served from the download page.
# Defaults to <RF_BUNDLE_DIR>/client. It is mounted read-only, never baked into an image.
#RF_CLIENT_SRC=../rf2232-v0.6.0/client

# ------------------------------------------------------------ gameserver ---
RF_DEBUG=0
# 0 = unlimited
RF_MAX_SESSIONS=0
# 1 = clients that announce a Lua script may log in, 0 = refuse them
RF_ALLOW_SCRIPTED_CLIENTS=1
# Go pprof on 127.0.0.1 inside the container (0 = off)
RF_PROFILE_PORT=0
# default | legacy | client   (legacy/client need files under RF_DATA_DIR/custom, see README)
RF_GAMEDATA_MODE=default
RF_LEGACY_PATH=gamedata-legacy
RF_CLIENT_PATH=gamedata-client
RF_LEGACY_ZONES=all

# ------------------------------------------------------------- webserver ---
# Leave empty unless you serve the site from several subdomains.
RF_COOKIE_DOMAIN=
# Public hostname -> built-in Let's Encrypt HTTPS on 80/443 (rfctl adds the TLS overlay).
RF_TLS_DOMAIN=
# Update-check service ("" = upstream) and channel: release | beta | dev
RF_UPDATE_URL=
RF_UPDATE_CHANNEL=release

# -------------------------------------------------------------- database ---
# sqlite (zero install, files in RF_DATA_DIR/db) or mysql
RF_DB_PROVIDER=sqlite
# 1 = run the bundled MySQL container (profile "mysql"); 0 = use your own server at RF_DB_HOST
RF_MYSQL_BUNDLED=1
RF_MYSQL_IMAGE=mysql:8.4
RF_DB_HOST=mysql
RF_DB_PORT=3306
# Application account the servers use. No spaces, no '#', no '//' (settings.cfg limits).
RF_DB_USER=rf2232
RF_DB_PASSWORD=CHANGEME
# Root password: creates the databases, the app user and its grants; used for backups.
# Required with the bundled MySQL. With an external server, leave empty to do
# everything as RF_DB_USER (it then needs CREATE privileges).
RF_DB_ROOT_PASSWORD=
RF_DB_ACCOUNTS=gommo_accounts
RF_DB_GAME=gommo_rf2232
RF_DB_GAMEDATA=gamedata_rf2232

# --------------------------------------------------------------- backups ---
# Automatic backups every N hours (0 = off), rotating the last N automatic ones.
RF_BACKUP_EVERY_HOURS=24
RF_BACKUP_KEEP=10
# 1 = also take one a minute after the stack starts
RF_BACKUP_ON_START=0
# 1 = include the large game content DB (needed to keep game-data editor changes)
RF_BACKUP_GAMEDATA=1

# ----------------------------------------------------------------- rfctl ---
# Seconds rfctl waits for "gameserver started" (first MySQL start imports ~2.7M rows).
RF_START_TIMEOUT=900
